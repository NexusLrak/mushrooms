[
{"latin":"Amanita phalloides","zh":"毒鹅膏","alias":["死帽蕈","毒伞"],"colors":["绿","黄","白"],"shape":"伞形","regions":["欧洲","北美"],"tox":"剧毒","habitat":["阔叶林"],"season":["夏","秋"],"traits":["菌根","有菌环","有菌托"],"lookalikes":["Russula virescens","Volvariella volvacea"],"note":"全球致死蘑菇中毒的头号元凶，含鹅膏毒肽，损伤肝肾。菌盖橄榄绿至黄绿，菌褶白色，有菌环和袋状菌托。中毒后有“假愈期”，极易延误治疗。"},
{"latin":"Amanita exitialis","zh":"致命鹅膏","imageFrom":"inaturalist","alias":["致命白毒伞"],"colors":["白"],"shape":"伞形","regions":["华南"],"tox":"剧毒","habitat":["阔叶林"],"season":["春","夏"],"traits":["菌根","有菌环","有菌托"],"lookalikes":["Amanita virosa","Volvariella volvacea"],"note":"广东等地春季中毒死亡事件的主要种类，通体纯白，常生于黧蒴锥林下。一两朵即可致命。"},
{"latin":"Amanita virosa","zh":"鳞柄白鹅膏","alias":["毁灭天使","白毒伞"],"colors":["白"],"shape":"伞形","regions":["欧洲","东北","日本"],"tox":"剧毒","habitat":["针叶林","混交林"],"season":["夏","秋"],"traits":["菌根","有菌环","有菌托"],"lookalikes":["Agaricus bisporus","Calvatia gigantea"],"note":"通体雪白，菌柄有纤毛状鳞片，基部有袋状菌托。与可食的白色蘑菇极易混淆，含鹅膏毒肽。"},
{"latin":"Amanita fuliginea","zh":"灰花纹鹅膏","alias":[],"colors":["灰","黑"],"shape":"伞形","regions":["华中","华东","华南","西南"],"tox":"剧毒","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["菌根","有菌环","有菌托"],"note":"菌盖深灰至黑褐色，有放射状纤丝花纹。是中国南方致死事件最多的鹅膏之一。"},
{"latin":"Amanita subjunquillea","zh":"黄盖鹅膏","alias":["黄盖毒伞"],"colors":["黄"],"shape":"伞形","regions":["东北","华北","华中","西南","日本"],"tox":"剧毒","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["菌根","有菌环","有菌托"],"note":"菌盖黄褐至污橙黄色，菌褶白色，有菌环和菌托。含鹅膏毒肽，是华北、东北常见的致死种类。"},
{"latin":"Amanita muscaria","zh":"毒蝇鹅膏","alias":["毒蝇伞","蛤蟆菌"],"colors":["红","白"],"shape":"伞形","regions":["欧洲","北美","东北","西北"],"tox":"有毒","habitat":["针叶林","混交林"],"season":["夏","秋"],"traits":["菌根","致幻","有菌环","有菌托"],"lookalikes":["Amanita hemibapha","Amanita pantherina"],"note":"最具辨识度的蘑菇：鲜红菌盖上散布白色疣状鳞片。含鹅膏蕈氨酸和蝇蕈醇，引起神经精神症状。常与桦树、松树共生。"},
{"latin":"Amanita pantherina","zh":"豹斑鹅膏","alias":["豹斑毒伞"],"colors":["褐","白"],"shape":"伞形","regions":["欧洲","东北","华北","西南"],"tox":"有毒","habitat":["针叶林","阔叶林"],"season":["夏","秋"],"traits":["菌根","有菌环","有菌托"],"note":"褐色菌盖上有白色斑点，似豹纹。毒素与毒蝇鹅膏相同但含量更高，引起谵妄、抽搐。"},
{"latin":"Amanita hemibapha","zh":"红黄鹅膏","alias":["鸡蛋菌","黄罗伞"],"colors":["红","橙","黄"],"shape":"伞形","regions":["西南","华南"],"tox":"慎食","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["菌根","有菌环","有菌托"],"note":"云南市场上的“鸡蛋菌”，幼时包在白色蛋状菌托中。本身可食，但与多种有毒鹅膏相似，非专业人士切勿采食。"},
{"latin":"Galerina marginata","zh":"纹缘盔孢伞","alias":["秋生盔孢伞"],"colors":["褐","黄"],"shape":"伞形","regions":["欧洲","北美","东北","华北","西南","西北"],"tox":"剧毒","habitat":["腐木"],"season":["秋"],"traits":["有菌环"],"lookalikes":["Flammulina filiformis","Armillaria mellea","Hypholoma fasciculare"],"note":"不起眼的黄褐色小蘑菇，簇生于腐木上，含鹅膏毒肽。常被误认作蜜环菌或金针菇野生型。"},
{"latin":"Lepiota brunneoincarnata","zh":"肉褐鳞环柄菇","alias":[],"colors":["褐","粉"],"shape":"伞形","regions":["欧洲","华北","华东","东北"],"tox":"剧毒","habitat":["草地","阔叶林"],"season":["夏","秋"],"traits":[],"note":"小型环柄菇，菌盖有肉褐色同心鳞片。含鹅膏毒肽，常长在小区绿地、路边，近年华北、华东多次致死。"},
{"latin":"Russula subnigricans","zh":"亚稀褶红菇","alias":["亚稀褶黑菇","火炭菌（混称）"],"colors":["灰","褐","黑"],"shape":"伞形","regions":["华中","华东","华南","西南","日本"],"tox":"剧毒","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["菌根","伤变色"],"note":"引起横纹肌溶解，死亡率高。受伤后变红而不变黑，以此区别于可食的稀褶黑菇——但这一区别对普通人很不可靠。"},
{"latin":"Gyromitra esculenta","zh":"鹿花菌","alias":["假羊肚菌"],"colors":["褐","红"],"shape":"脑状","regions":["欧洲","北美","东北"],"tox":"剧毒","habitat":["针叶林"],"season":["春"],"traits":[],"lookalikes":["Morchella esculenta"],"note":"菌盖呈脑状皱褶而非蜂窝状，是羊肚菌最危险的相似种。含鹿花菌素，可代谢为火箭燃料成分甲基肼。"},
{"latin":"Cortinarius orellanus","zh":"毒丝膜菌","alias":["奥来丝膜菌"],"colors":["橙","褐"],"shape":"伞形","regions":["欧洲"],"tox":"剧毒","habitat":["阔叶林"],"season":["夏","秋"],"traits":["菌根"],"note":"含奥来毒素，潜伏期可长达2–3周，之后出现急性肾衰竭。橙褐色，外观平淡无奇。"},
{"latin":"Trogia venenata","zh":"毒沟褶菌","alias":["小白菌"],"colors":["粉","白"],"shape":"扇形","regions":["西南"],"tox":"剧毒","habitat":["腐木"],"season":["夏"],"traits":[],"note":"2010年前后被确认为“云南不明原因猝死”的元凶。粉白色小型扇状菌，生于腐木，含有毒的非蛋白氨基酸。"},
{"latin":"Trichoderma cornu-damae","zh":"红角肉棒菌","alias":["火焰茸"],"colors":["红","橙"],"shape":"珊瑚状","regions":["日本","华东","西南"],"tox":"剧毒","habitat":["腐木","阔叶林"],"season":["夏","秋"],"traits":[],"lookalikes":["Ganoderma lingzhi","Cordyceps militaris"],"note":"形似红色鹿角或火焰，含单端孢霉烯族毒素，据称接触皮肤即可引起炎症。曾被误当作幼嫩灵芝或虫草。"},
{"latin":"Chlorophyllum molybdites","zh":"大青褶伞","alias":["绿褶菇","铅绿褶菇"],"colors":["白","褐","绿"],"shape":"伞形","regions":["华南","华东","华中","西南","北美","热带"],"tox":"有毒","habitat":["草地"],"season":["夏","秋"],"traits":["有菌环"],"lookalikes":["Macrolepiota procera"],"note":"中国引发中毒事件最多的蘑菇。大型、白色带褐色鳞片，常在雨后草坪成群出现；成熟后菌褶变青绿色是关键特征。引起剧烈胃肠炎。"},
{"latin":"Omphalotus japonicus","zh":"月夜菌","alias":["日本类脐菇","发光类脐菇"],"colors":["褐","紫"],"shape":"扇形","regions":["东北","华中","日本"],"tox":"有毒","habitat":["腐木"],"season":["秋"],"traits":["发光"],"lookalikes":["Pleurotus ostreatus","Lentinula edodes"],"note":"生于枯木上，外形像平菇或香菇，菌褶在黑暗中发出微弱绿光。剖开菌柄基部常有黑斑。"},
{"latin":"Hypholoma fasciculare","zh":"簇生垂幕菇","alias":["簇生沿丝伞","苦栗菌"],"colors":["黄","绿"],"shape":"伞形","regions":["欧洲","北美","东北","华北","华东","华中","西南"],"tox":"有毒","habitat":["腐木"],"season":["春","夏","秋"],"traits":[],"lookalikes":["Armillaria mellea"],"note":"硫磺黄色，大簇生于树桩，菌褶带橄榄绿色，味极苦。常见，引起胃肠炎。"},
{"latin":"Russula emetica","zh":"毒红菇","alias":["呕吐红菇"],"colors":["红","白"],"shape":"伞形","regions":["欧洲","北美","东北","西南"],"tox":"有毒","habitat":["针叶林"],"season":["夏","秋"],"traits":["菌根"],"lookalikes":["Russula griseocarnosa"],"note":"鲜红菌盖、纯白菌褶和菌柄，味辛辣。生食引起呕吐腹泻。红菇属种类繁多，红色种类之间极难区分。"},
{"latin":"Lactarius torminosus","zh":"疝疼乳菇","alias":["毛头乳菇"],"colors":["粉","橙"],"shape":"漏斗形","regions":["欧洲","北美","东北","西北"],"tox":"有毒","habitat":["阔叶林"],"season":["夏","秋"],"traits":["菌根","有乳汁"],"lookalikes":["Lactarius deliciosus"],"note":"粉红色菌盖带同心环纹，边缘有长绒毛，与桦树共生，乳汁白色辛辣。生食有毒；北欧、俄罗斯经腌制去辣后食用。"},
{"latin":"Coprinopsis atramentaria","zh":"墨汁拟鬼伞","alias":["墨汁鬼伞"],"colors":["灰","褐"],"shape":"钟形","regions":["欧洲","北美","东北","华北","华东","华中","西南","西北"],"tox":"慎食","habitat":["草地","腐木"],"season":["春","夏","秋"],"traits":["自溶"],"lookalikes":["Coprinus comatus"],"note":"成熟后菌褶自溶成墨汁。本身可食，但含鬼伞素，食用前后数日内饮酒会出现类似双硫仑反应的中毒症状。"},
{"latin":"Psilocybe cubensis","zh":"古巴裸盖菇","alias":["古巴光盖伞"],"colors":["黄","褐"],"shape":"伞形","regions":["热带","华南","北美"],"tox":"有毒","habitat":["粪生","草地"],"season":["夏","秋"],"traits":["致幻","伤变蓝","有菌环"],"note":"生于牛粪上，受伤处变蓝。含裸盖菇素，引起幻觉；在中国属管制物质来源，不可采食。"},
{"latin":"Gymnopilus junonius","zh":"橘黄裸伞","alias":["大笑菌"],"colors":["橙","黄"],"shape":"伞形","regions":["欧洲","北美","东北","华中","西南","日本"],"tox":"有毒","habitat":["腐木"],"season":["夏","秋"],"traits":["致幻","有菌环"],"note":"大型橙黄色蘑菇，簇生于树桩，味苦。部分居群含致幻成分，日本称“大笑茸”。"},
{"latin":"Scleroderma citrinum","zh":"橙黄硬皮马勃","alias":[],"colors":["黄","褐"],"shape":"球形","regions":["欧洲","北美","华东","华南","西南"],"tox":"有毒","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["菌根"],"lookalikes":["Lycoperdon perlatum","Calvatia gigantea"],"note":"外皮厚硬、有龟裂鳞片，内部早期即呈紫黑色，以此区别于内部纯白的可食马勃。引起胃肠炎。"},
{"latin":"Paxillus involutus","zh":"卷边桩菇","alias":["卷边网褶菌"],"colors":["褐"],"shape":"漏斗形","regions":["欧洲","北美","东北","华北","西南"],"tox":"有毒","habitat":["阔叶林","针叶林"],"season":["夏","秋"],"traits":["菌根","伤变色"],"note":"菌盖边缘明显内卷，菌褶受压变褐。曾被广泛食用，后发现反复食用可诱发致命的免疫性溶血。"},
{"latin":"Entoloma sinuatum","zh":"毒粉褶菌","alias":["土生红褶菌"],"colors":["灰","白","粉"],"shape":"伞形","regions":["欧洲","东北","华北","华东","西南"],"tox":"有毒","habitat":["阔叶林"],"season":["夏","秋"],"traits":[],"note":"灰白色大型蘑菇，菌褶成熟后变粉红，有面粉气味。欧洲蘑菇中毒的常见原因，引起严重胃肠炎。"},
{"latin":"Agaricus xanthodermus","zh":"黄斑蘑菇","alias":[],"colors":["白","黄"],"shape":"伞形","regions":["欧洲","北美","华北","西北"],"tox":"有毒","habitat":["草地","阔叶林"],"season":["夏","秋"],"traits":["伤变色","有菌环"],"lookalikes":["Agaricus bisporus"],"note":"外形像野生双孢蘑菇，但擦伤后迅速变鲜黄色（菌柄基部尤甚），并有石炭酸（墨水）气味。"},
{"latin":"Tricholoma equestre","zh":"油口蘑","alias":["黄口蘑","骑士蘑"],"colors":["黄"],"shape":"伞形","regions":["欧洲","北美","东北","西南"],"tox":"有毒","habitat":["针叶林"],"season":["秋"],"traits":["菌根"],"note":"曾是欧洲的传统食用菌，2001年起因大量连续食用导致横纹肌溶解死亡的报告而被重新列为有毒。"},
{"latin":"Hygrocybe conica","zh":"锥形湿伞","alias":["变黑蜡伞"],"colors":["红","橙","黑"],"shape":"钟形","regions":["欧洲","北美","东北","华东","华南","西南"],"tox":"有毒","habitat":["草地","阔叶林"],"season":["夏","秋"],"traits":["伤变色"],"note":"尖锥形的橙红色小蘑菇，触碰或老熟后整体变黑。毒性存疑，一般不建议食用。"},
{"latin":"Lanmaoa asiatica","zh":"兰茂牛肝菌","alias":["红葱","红见手青"],"colors":["红","黄","蓝"],"shape":"伞形","regions":["西南"],"tox":"慎食","habitat":["针叶林","混交林"],"season":["夏"],"traits":["菌根","伤变蓝","致幻","名贵"],"note":"云南“见手青”的代表，菌盖红色、菌孔黄色，触碰即变蓝。必须充分炒熟，未熟透食用会出现“看见小人”的幻视。"},
{"latin":"Tylopilus felleus","zh":"苦粉孢牛肝菌","alias":[],"colors":["褐","粉"],"shape":"伞形","regions":["欧洲","北美","东北","西南"],"tox":"不可食","habitat":["针叶林","混交林"],"season":["夏","秋"],"traits":["菌根"],"lookalikes":["Boletus edulis"],"note":"外形酷似美味牛肝菌，但菌孔粉红、菌柄有深色网纹，味道奇苦，一朵就能毁掉一锅菜。"},
{"latin":"Lentinula edodes","zh":"香菇","alias":["冬菇","花菇","椎茸"],"colors":["褐"],"shape":"伞形","regions":["华东","华中","华南","西南","日本"],"tox":"可食用","habitat":["腐木","栽培"],"season":["春","秋","冬"],"traits":["栽培"],"note":"东亚栽培历史最悠久的食用菌，原生于壳斗科阔叶树倒木。注意：生食或未熟透可能引起“香菇皮炎”。"},
{"latin":"Pleurotus ostreatus","zh":"糙皮侧耳","alias":["平菇","蚝菇"],"colors":["灰","白","褐"],"shape":"扇形","regions":["欧洲","北美","东北","华北","华东","华中","西南","西北"],"tox":"可食用","habitat":["腐木","栽培"],"season":["秋","冬","春"],"traits":["栽培"],"note":"叠生于阔叶树枯木，菌褶延生、菌柄侧生或近无。产量最大的栽培菌之一。野外注意与月夜菌区分。"},
{"latin":"Pleurotus eryngii","zh":"杏鲍菇","alias":["刺芹侧耳"],"colors":["白","褐"],"shape":"伞形","regions":["欧洲","西北"],"tox":"可食用","habitat":["草地","栽培"],"season":["春","秋"],"traits":["栽培"],"note":"野生于伞形科刺芹等植物的根部，菌柄粗壮肥厚。如今几乎都来自工厂化栽培。"},
{"latin":"Flammulina filiformis","zh":"金针菇","alias":["冬菇","毛柄金钱菌"],"colors":["黄","褐","白"],"shape":"伞形","regions":["东北","华北","华东","华中","西南","日本"],"tox":"可食用","habitat":["腐木","栽培"],"season":["秋","冬","春"],"traits":["栽培"],"wiki":"金针菇","note":"野生型菌盖黄褐发黏、菌柄下部有深色绒毛，耐寒；超市里细长白色的形态是避光、高二氧化碳栽培的结果。野外须与剧毒的纹缘盔孢伞区分。"},
{"latin":"Agaricus bisporus","zh":"双孢蘑菇","alias":["口蘑（商品名）","白蘑菇","褐菇"],"colors":["白","褐"],"shape":"伞形","regions":["欧洲","北美"],"tox":"可食用","habitat":["草地","栽培"],"season":["春","夏","秋"],"traits":["栽培","有菌环"],"note":"全世界栽培最广的蘑菇。白蘑菇、褐菇、波特贝勒大褐菇都是同一个种的不同品系或成熟度。"},
{"latin":"Auricularia heimuer","zh":"黑木耳","alias":["木耳","云耳"],"colors":["黑","褐"],"shape":"耳状","regions":["东北","华北","华中","西南"],"tox":"可食用","habitat":["腐木","栽培"],"season":["夏","秋"],"traits":["栽培","胶质"],"wiki":"黑木耳","lookalikes":["Auricularia cornea"],"note":"胶质、耳状，生于阔叶树枯木。注意：长时间泡发的木耳可能滋生椰毒假单胞菌，产生致命的米酵菌酸——那是细菌污染，不是木耳本身有毒。"},
{"latin":"Auricularia cornea","zh":"毛木耳","alias":["黄背木耳","白背木耳"],"colors":["褐","紫","灰"],"shape":"耳状","regions":["华东","华中","华南","西南","热带"],"tox":"可食用","habitat":["腐木","栽培"],"season":["夏","秋"],"traits":["栽培","胶质"],"note":"比黑木耳更大更厚，背面密生灰白色绒毛，口感脆硬，常用于凉拌和川菜。"},
{"latin":"Tremella fuciformis","zh":"银耳","alias":["白木耳","雪耳"],"colors":["白"],"shape":"耳状","regions":["华东","华中","华南","西南","热带"],"tox":"可食用","habitat":["腐木","栽培"],"season":["夏","秋"],"traits":["栽培","胶质"],"note":"白色半透明、花瓣状胶质菌。实际上寄生于另一种真菌（香灰菌），栽培时需两种菌混合接种。"},
{"latin":"Naematelia aurantialba","zh":"金耳","alias":["黄木耳","脑耳"],"colors":["黄","橙"],"shape":"脑状","regions":["西南","西北"],"tox":"可食用","habitat":["腐木"],"season":["夏","秋"],"traits":["胶质","名贵"],"note":"金黄色脑状胶质菌，寄生于韧革菌上。主产云南、西藏，传统滋补食材。"},
{"latin":"Hericium erinaceus","zh":"猴头菇","alias":["猴头菌","刺猬菌"],"colors":["白","黄"],"shape":"齿状","regions":["东北","华北","西南","欧洲","北美","日本"],"tox":"可食用","habitat":["腐木","栽培"],"season":["夏","秋"],"traits":["栽培","药用"],"note":"球状、垂下密集长刺，形似猴头，生于栎类等阔叶树的伤口或枯干。几乎没有危险的相似种。"},
{"latin":"Morchella esculenta","zh":"羊肚菌","alias":["羊肚蘑"],"colors":["黄","褐"],"shape":"蜂窝状","regions":["欧洲","北美","东北","华北","西南","西北"],"tox":"慎食","habitat":["阔叶林","草地"],"season":["春"],"traits":["名贵"],"note":"菌盖蜂窝状、与菌柄连成中空的一体。必须熟食，生食或与酒同食可致不适。务必剖开确认中空，以区别于剧毒的鹿花菌。"},
{"latin":"Tricholoma matsutake","zh":"松茸","alias":["松口蘑"],"colors":["褐","白"],"shape":"伞形","regions":["西南","东北","青藏高原","日本"],"tox":"可食用","habitat":["针叶林","混交林"],"season":["夏","秋"],"traits":["菌根","名贵","有菌环"],"lookalikes":["Catathelasma ventricosum"],"note":"与松树、栎树共生，无法人工栽培，有独特浓香。主产云南香格里拉、四川、吉林延边。"},
{"latin":"Catathelasma ventricosum","zh":"梭柄松苞菇","alias":["老人头"],"colors":["白","灰"],"shape":"伞形","regions":["西南","青藏高原","北美"],"tox":"可食用","habitat":["针叶林"],"season":["夏","秋"],"traits":["菌根","有菌环"],"note":"云南、四川市场上的“老人头”，粗壮肥厚、菌柄梭形深入土中，常被当作松茸的平价替代品。"},
{"latin":"Boletus edulis","zh":"美味牛肝菌","alias":["白牛肝","大脚菇","牛肝菌"],"colors":["褐","白"],"shape":"伞形","regions":["欧洲","北美","东北","西南"],"tox":"可食用","habitat":["针叶林","混交林"],"season":["夏","秋"],"traits":["菌根","名贵"],"note":"菌盖褐色如面包，菌孔幼时白色后变黄绿，菌柄粗壮有白色细网纹，伤不变色。云南的“白牛肝”多为近缘的白牛肝菌（B. bainiugan）。"},
{"latin":"Suillus luteus","zh":"褐环乳牛肝菌","alias":["黏团子","松蘑"],"colors":["褐","黄"],"shape":"伞形","regions":["欧洲","北美","东北","华北","西南"],"tox":"慎食","habitat":["针叶林"],"season":["夏","秋"],"traits":["菌根","有菌环"],"note":"菌盖黏滑，生于松林。可食但黏滑的表皮易致腹泻，宜撕去表皮并充分煮熟。"},
{"latin":"Cantharellus cibarius","zh":"鸡油菌","alias":["杏菌","黄丝菌"],"colors":["黄","橙"],"shape":"漏斗形","regions":["欧洲","东北","西南","华中"],"tox":"可食用","habitat":["阔叶林","针叶林"],"season":["夏","秋"],"traits":["菌根","名贵"],"note":"蛋黄色、喇叭状，菌盖下是分叉的钝棱而非真正的菌褶，有杏子香味。中国所产多为若干近缘种。"},
{"latin":"Termitomyces eurrhizus","zh":"鸡枞","alias":["鸡枞菌","真根蚁巢伞"],"colors":["灰","褐","白"],"shape":"伞形","regions":["西南","华南","热带"],"tox":"可食用","habitat":["白蚁巢"],"season":["夏"],"traits":["名贵"],"note":"菌盖中央有尖突，菌柄下延成长长的“假根”直通地下白蚁巢，与白蚁共生，无法离开白蚁人工栽培。"},
{"latin":"Thelephora ganbajun","zh":"干巴菌","alias":["干巴革菌"],"colors":["灰","黑"],"shape":"珊瑚状","regions":["西南"],"tox":"可食用","habitat":["针叶林"],"season":["夏","秋"],"traits":["菌根","名贵"],"note":"云南特产，生于云南松林下，灰黑色、莲座状分枝，有类似腌牛肉干巴的浓烈香气。"},
{"latin":"Phallus indusiatus","zh":"长裙竹荪","alias":["竹荪","竹笙"],"colors":["白","褐"],"shape":"笔形","regions":["西南","华南","华东","热带"],"tox":"可食用","habitat":["竹林"],"season":["夏","秋"],"traits":["栽培","有菌托"],"lookalikes":["Phallus impudicus"],"note":"从蛋形菌蕾中数小时内伸出，顶端有暗绿色恶臭孢体，垂下洁白的网状菌裙。食用部分是去掉菌盖和菌托后的菌柄与菌裙。"},
{"latin":"Phallus impudicus","zh":"白鬼笔","alias":["臭角菌"],"colors":["白","绿"],"shape":"笔形","regions":["欧洲","北美","东北","华北","西南"],"tox":"慎食","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["有菌托"],"note":"顶端覆盖橄榄绿色黏液，散发腐肉恶臭以吸引苍蝇传播孢子。菌蛋阶段在部分地区被食用。"},
{"latin":"Tuber indicum","zh":"印度块菌","alias":["中国黑松露","猪拱菌"],"colors":["黑","褐"],"shape":"球形","regions":["西南"],"tox":"可食用","habitat":["地下","针叶林","阔叶林"],"season":["冬"],"traits":["菌根","名贵"],"note":"生于地下，表面有多角形疣突，切面黑色带白色大理石纹。主产云南、四川攀枝花。"},
{"latin":"Lactarius deliciosus","zh":"松乳菇","alias":["美味乳菇","谷熟菌"],"colors":["橙","绿"],"shape":"漏斗形","regions":["欧洲","华东","华中","西南"],"tox":"可食用","habitat":["针叶林"],"season":["夏","秋"],"traits":["菌根","有乳汁","伤变色"],"note":"橙色菌盖带同心环纹，受伤流出胡萝卜色乳汁，随后慢慢变绿。生于松林。"},
{"latin":"Lactarius indigo","zh":"靛蓝乳菇","alias":["蓝乳菇"],"colors":["蓝"],"shape":"漏斗形","regions":["北美","西南","日本"],"tox":"可食用","habitat":["阔叶林","针叶林"],"season":["夏","秋"],"traits":["菌根","有乳汁"],"note":"通体靛蓝色，切开流出蓝色乳汁——蓝色的可食蘑菇极为罕见。"},
{"latin":"Russula virescens","zh":"变绿红菇","alias":["青头菌","绿菇"],"colors":["绿"],"shape":"伞形","regions":["欧洲","东北","华东","华中","华南","西南"],"tox":"可食用","habitat":["阔叶林","混交林"],"season":["夏","秋"],"traits":["菌根"],"note":"菌盖浅绿色、表皮龟裂成斑块，菌褶和菌柄白色。云南常见野生菌。初学者须警惕：毒鹅膏也是绿色的，但它有菌环和菌托。"},
{"latin":"Russula griseocarnosa","zh":"灰肉红菇","alias":["正红菇","大红菇"],"colors":["红"],"shape":"伞形","regions":["华南","华东","西南"],"tox":"可食用","habitat":["阔叶林"],"season":["夏","秋"],"traits":["菌根","名贵"],"note":"福建、广西、云南的“正红菇”，菌盖深红、菌肉带灰色，煮汤呈红色。红色红菇种类多且有毒种混杂，采食风险高。"},
{"latin":"Coprinus comatus","zh":"毛头鬼伞","alias":["鸡腿菇"],"colors":["白","褐"],"shape":"钟形","regions":["欧洲","北美","东北","华北","华东","西南","西北"],"tox":"可食用","habitat":["草地","栽培"],"season":["春","夏","秋"],"traits":["栽培","自溶","有菌环"],"note":"圆柱形白色菌盖布满翻卷的鳞片，成熟后从边缘开始自溶成墨汁，须在幼嫩未变黑时食用。"},
{"latin":"Volvariella volvacea","zh":"草菇","alias":["稻草菇","兰花菇"],"colors":["灰","黑","白"],"shape":"伞形","regions":["华南","华东","热带"],"tox":"可食用","habitat":["草地","栽培"],"season":["夏"],"traits":["栽培","有菌托"],"note":"喜高温，传统上用稻草栽培，食用的是未开伞的蛋形菌蕾。有菌托、无菌环——海外华人误把毒鹅膏当草菇的中毒事件屡有发生。"},
{"latin":"Macrolepiota procera","zh":"高大环柄菇","alias":["高脚环柄菇","雨伞菇"],"colors":["褐","白"],"shape":"伞形","regions":["欧洲","北美","东北","华北","西南"],"tox":"慎食","habitat":["草地","阔叶林"],"season":["夏","秋"],"traits":["有菌环"],"note":"大型，菌柄细长有蛇皮状花纹，菌环可上下移动。可食，但与有毒的大青褶伞相似（后者菌褶变绿）。"},
{"latin":"Stropharia rugosoannulata","zh":"皱环球盖菇","alias":["大球盖菇","赤松茸"],"colors":["红","褐"],"shape":"伞形","regions":["欧洲","北美","华东","西南"],"tox":"可食用","habitat":["草地","栽培"],"season":["春","秋"],"traits":["栽培","有菌环"],"note":"酒红色菌盖，菌环厚而有齿轮状沟纹。可在秸秆、木屑上露地栽培，商品名“赤松茸”，与松茸无关。"},
{"latin":"Hypsizygus marmoreus","zh":"斑玉蕈","alias":["蟹味菇","真姬菇","白玉菇"],"colors":["褐","白"],"shape":"伞形","regions":["日本","东北","欧洲"],"tox":"可食用","habitat":["腐木","栽培"],"season":["秋"],"traits":["栽培"],"note":"菌盖有大理石状斑纹，丛生。褐色品系称蟹味菇，白色品系称白玉菇。"},
{"latin":"Armillaria mellea","zh":"蜜环菌","alias":["榛蘑"],"colors":["黄","褐"],"shape":"伞形","regions":["欧洲","北美","东北","华北","西南"],"tox":"慎食","habitat":["腐木","树干"],"season":["秋"],"traits":["发光","有菌环"],"note":"东北名菜“小鸡炖蘑菇”的榛蘑。成丛生于树基，菌丝体可发光，并与天麻共生。必须充分煮熟，生食或半熟会引起胃肠不适。"},
{"latin":"Grifola frondosa","zh":"灰树花","alias":["舞茸","栗蘑"],"colors":["灰","褐"],"shape":"扇形","regions":["东北","华北","华东","日本","欧洲","北美"],"tox":"可食用","habitat":["树干","栽培"],"season":["秋"],"traits":["栽培","药用"],"note":"由无数扇形小菌盖层叠成一大丛，生于栎树、板栗树基部。河北迁西称“栗蘑”。"},
{"latin":"Sparassis crispa","zh":"绣球菌","alias":["花椰菜菌"],"colors":["白","黄"],"shape":"珊瑚状","regions":["欧洲","东北","西南","日本"],"tox":"可食用","habitat":["针叶林","树干"],"season":["夏","秋"],"traits":["栽培"],"note":"由波浪状薄片组成的大型球状菌，形似绣球花或花椰菜，生于松树基部。东亚所产多为近缘的广叶绣球菌。"},
{"latin":"Ramaria botrytis","zh":"葡萄状枝瑚菌","alias":["扫帚菌","珊瑚菌"],"colors":["粉","白","紫"],"shape":"珊瑚状","regions":["欧洲","北美","东北","西南"],"tox":"慎食","habitat":["阔叶林"],"season":["夏","秋"],"traits":["菌根"],"note":"粗壮的白色基部分出许多枝，枝顶粉紫色。可食，但珊瑚菌类中有数种会致腹泻，颜色相近难以分辨。"},
{"latin":"Laetiporus sulphureus","zh":"硫磺菌","alias":["硫色絢孔菌","树鸡"],"colors":["黄","橙"],"shape":"檐状","regions":["欧洲","北美","东北","华北","西南"],"tox":"慎食","habitat":["树干","腐木"],"season":["夏","秋"],"traits":[],"note":"鲜艳的硫黄至橙色层叠檐状菌，幼嫩时口感似鸡肉。部分人食后有过敏或胃肠反应，须熟食并少量尝试。"},
{"latin":"Ganoderma lingzhi","zh":"灵芝","alias":["赤芝","红芝"],"colors":["红","褐"],"shape":"檐状","regions":["华东","华中","华南","西南","日本"],"tox":"不可食","habitat":["腐木","树干","栽培"],"season":["夏","秋"],"traits":["药用","栽培"],"wiki":"灵芝","note":"菌盖肾形，红褐色有漆样光泽，木栓质。质地坚硬不能作菜，传统上切片煎煮或提取入药。"},
{"latin":"Trametes versicolor","zh":"云芝","alias":["彩绒革盖菌","火鸡尾"],"colors":["褐","灰","蓝","白"],"shape":"檐状","regions":["欧洲","北美","东北","华北","华东","华中","华南","西南","西北"],"tox":"不可食","habitat":["腐木"],"season":["春","夏","秋","冬"],"traits":["药用"],"note":"世界上最常见的木腐菌之一，薄革质，表面有多色同心环带和绒毛。革质难嚼，用作药材（云芝多糖）。"},
{"latin":"Fomes fomentarius","zh":"木蹄层孔菌","alias":["火绒菌"],"colors":["灰","褐"],"shape":"檐状","regions":["欧洲","北美","东北","华北","西北"],"tox":"不可食","habitat":["树干"],"season":["春","夏","秋","冬"],"traits":["药用"],"note":"马蹄形多年生硬质菌，多生于桦树。菌肉可制成引火的火绒，冰人奥茨随身就带着它。"},
{"latin":"Inonotus obliquus","zh":"桦褐孔菌","alias":["白桦茸"],"colors":["黑","褐"],"shape":"球形","regions":["东北","欧洲","北美"],"tox":"不可食","habitat":["树干"],"season":["春","夏","秋","冬"],"traits":["药用"],"note":"生于白桦树干上的黑色焦炭状瘤块（不育菌核）。俄罗斯等地泡茶饮用；草酸含量很高，长期大量饮用有肾损伤报告。"},
{"latin":"Wolfiporia cocos","zh":"茯苓","alias":["云苓","松苓"],"colors":["褐","白"],"shape":"球形","regions":["华东","华中","西南"],"tox":"可食用","habitat":["地下","针叶林","栽培"],"season":["夏","秋"],"traits":["药用","栽培"],"wiki":"茯苓","note":"寄生于松树根部的地下菌核，外皮黑褐、内部白色。药食两用，茯苓饼、龟苓膏的原料。"},
{"latin":"Ophiocordyceps sinensis","zh":"冬虫夏草","alias":["虫草"],"colors":["褐","黄"],"shape":"棒状","regions":["青藏高原","西南"],"tox":"可食用","habitat":["高山草甸"],"season":["春","夏"],"traits":["药用","名贵","虫生"],"lookalikes":["Cordyceps militaris"],"note":"寄生于蝙蝠蛾幼虫，冬季菌丝充满虫体，夏初从虫头长出棒状子座。仅产于海拔3000米以上的高寒草甸。野生虫草砷含量偏高，不宜长期大量服用。"},
{"latin":"Cordyceps militaris","zh":"蛹虫草","alias":["北冬虫夏草","虫草花"],"colors":["橙"],"shape":"棒状","regions":["东北","华北","西南","欧洲","北美","日本"],"tox":"可食用","habitat":["阔叶林","栽培"],"season":["夏","秋"],"traits":["栽培","虫生","药用"],"note":"橙色棒状，野生时从土中的蛾蛹上长出。市场上的“虫草花”是它在谷物培养基上栽培的子实体。"},
{"latin":"Calvatia gigantea","zh":"大秃马勃","alias":["巨马勃"],"colors":["白"],"shape":"球形","regions":["欧洲","北美","东北","华北","西北"],"tox":"可食用","habitat":["草地"],"season":["夏","秋"],"traits":[],"note":"白色巨球，直径可超过50厘米。仅在内部纯白、质地均匀时可食；一旦变黄变褐即不可食。切开若见蘑菇雏形，则是鹅膏的菌蛋。"},
{"latin":"Lycoperdon perlatum","zh":"网纹马勃","alias":["马粪包"],"colors":["白","褐"],"shape":"球形","regions":["欧洲","北美","东北","华北","华东","华中","西南","西北"],"tox":"慎食","habitat":["阔叶林","针叶林","草地"],"season":["夏","秋"],"traits":[],"note":"陀螺形，表面密布易脱落的小刺，成熟后顶部开孔喷出孢子烟雾。幼嫩且内部纯白时可食；避免吸入孢子粉。"},
{"latin":"Geastrum triplex","zh":"尖顶地星","alias":["地星"],"colors":["褐"],"shape":"星状","regions":["欧洲","北美","东北","华北","西南"],"tox":"不可食","habitat":["阔叶林"],"season":["夏","秋"],"traits":[],"note":"外皮裂成星芒状向外翻卷，托起中央的孢子囊，雨滴击打时喷出孢子。"},
{"latin":"Clathrus archeri","zh":"阿切氏笼头菌","alias":["章鱼鬼笔","恶魔手指"],"colors":["红"],"shape":"星状","regions":["大洋洲","欧洲","北美"],"tox":"不可食","habitat":["草地","阔叶林"],"season":["夏","秋"],"traits":["有菌托"],"note":"从菌蛋中伸出4–7条红色“触手”，内侧布满暗色恶臭孢体。原产澳大利亚和新西兰，已随木屑扩散到欧洲。"},
